{
  "expo": {
    "name": "余量",
    "slug": "filament-scale",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F4EF",
    "splash": {
      "backgroundColor": "#F3F4EF",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.yuliang.filament"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yuliang.filament",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "余量",
      "shortName": "余量",
      "lang": "zh-CN",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "any",
      "themeColor": "#236B55",
      "backgroundColor": "#F3F4EF",
      "description": "拓竹云端耗材称重与库存管理"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sharing"
    ]
  }
}
