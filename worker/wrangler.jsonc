{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yuliang-filament",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "../dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
