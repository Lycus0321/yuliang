{
  "name": "filament-app",
  "version": "1.0.7",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.58.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "~19.3.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "build:web": "expo export --platform web --output-dir dist-web && node scripts/prepare-pwa.mjs",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview"
  },
  "private": true
}
